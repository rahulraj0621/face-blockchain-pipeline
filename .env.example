# ── SerpAPI (Google Lens reverse image search) ────────────────────────────────
# Sign up free at https://serpapi.com  (100 free searches/month)
SERPAPI_KEY=your_serpapi_key_here

# ── Infura (Ethereum RPC provider) ────────────────────────────────────────────
# Sign up free at https://infura.io and create a Web3 project
INFURA_PROJECT_ID=your_infura_project_id_here

# ── Ethereum Sepolia Testnet Wallet ───────────────────────────────────────────
# Private key of a wallet funded with free Sepolia ETH
# Get free ETH at: https://sepoliafaucet.com
# WARNING: Never commit your real private key to git!
ETH_PRIVATE_KEY=0xyour_private_key_here
ETH_ADDRESS=0xyour_wallet_address_here
